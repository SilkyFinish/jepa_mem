# Source a configs/*.local.env first; simulator locations are optional for train-only nodes.
: "${JEPA_SHARED_ROOT:?Set persistent JEPA_SHARED_ROOT}"
export JEPA_TRAIN_ONLY="${JEPA_TRAIN_ONLY:-0}"
if [[ "$JEPA_TRAIN_ONLY" != 1 ]]; then
  : "${RMBENCH_ROOT:?Set existing simulator checkout}"
  : "${RMBENCH_PYTHON:?Set existing simulator interpreter}"
fi
export JEPA_SHARED_ROOT RMBENCH_ROOT RMBENCH_PYTHON
export POLICY_ENV="${POLICY_ENV:-$JEPA_SHARED_ROOT/envs/policy}"
export POLICY_PYTHON="${POLICY_PYTHON:-$POLICY_ENV/bin/python}"
# Default to dense decisions, full 14x14 history and the server's frozen BERT.
export JEPA_TEXT_ENCODER="${JEPA_TEXT_ENCODER:-bert}"
export JEPA_BERT_SOURCE="${JEPA_BERT_SOURCE:-}"
export JEPA_HISTORY_MODEL_VERSION="${JEPA_HISTORY_MODEL_VERSION:-v2_full}"
export JEPA_HISTORY_BACKEND="${JEPA_HISTORY_BACKEND:-flex}"
export JEPA_SHARED_PREFIX="${JEPA_SHARED_PREFIX:-1}"
export JEPA_ACTION_CHECKPOINTING="${JEPA_ACTION_CHECKPOINTING:-1}"
export JEPA_PACK_FEATURES="${JEPA_PACK_FEATURES:-1}"
# Optional page-cache warming runs standalone before any distributed process.
export JEPA_WARM_OBSERVATIONS="${JEPA_WARM_OBSERVATIONS:-0}"
export JEPA_CACHE_ENCODER_BATCH="${JEPA_CACHE_ENCODER_BATCH:-4}"
export JEPA_GPUS="${JEPA_GPUS:-8}"
export JEPA_PER_DEVICE_BATCH="${JEPA_PER_DEVICE_BATCH:-2}"
export JEPA_EPOCHS="${JEPA_EPOCHS:-25}"
export JEPA_RUN_NAME="${JEPA_RUN_NAME:-put_back_block_full50_${JEPA_HISTORY_MODEL_VERSION}_${JEPA_TEXT_ENCODER}_ep${JEPA_EPOCHS}}"
export JEPA_ROLLOUTS="${JEPA_ROLLOUTS:-20}"
export JEPA_NUM_WORKERS="${JEPA_NUM_WORKERS:-2}"
export JEPA_CHECKPOINT_BLOCKS="${JEPA_CHECKPOINT_BLOCKS:-24}"
export JEPA_TORCH_INDEX="${JEPA_TORCH_INDEX:-https://download.pytorch.org/whl/cu126}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-2}"
export OPENBLAS_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export WANDB_MODE=disabled
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export PIP_CACHE_DIR="$JEPA_SHARED_ROOT/cache/pip"
export HF_HOME="$JEPA_SHARED_ROOT/cache/huggingface"
export XDG_CACHE_HOME="$JEPA_SHARED_ROOT/cache/xdg"
export TORCH_HOME="$JEPA_SHARED_ROOT/cache/torch"
export CONDA_PKGS_DIRS="$JEPA_SHARED_ROOT/cache/conda"
export TORCHINDUCTOR_COMPILE_THREADS="${TORCHINDUCTOR_COMPILE_THREADS:-1}"
export TORCHINDUCTOR_CACHE_DIR="$JEPA_SHARED_ROOT/cache/inductor"
export TRITON_CACHE_DIR="$JEPA_SHARED_ROOT/cache/triton"
export CUDA_CACHE_PATH="$JEPA_SHARED_ROOT/cache/cuda"
export PYTHONDONTWRITEBYTECODE=1
export WANDB_DIR="$JEPA_SHARED_ROOT/logs/wandb"
# A short IPC path is essential for DataLoader/planner UNIX sockets.
export TMPDIR="${JEPA_TMPDIR:-/tmp/jepa-$UID}"
# Do not override HOME, CUDA_VISIBLE_DEVICES or transport settings provided by the platform.
